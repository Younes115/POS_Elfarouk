generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ─────────────────────────────────────────────
// PRODUCT (Inventory)
// Represents a physical item stocked in the store.
// Price and cost fields are the *current* store values.
// Historical values at point-of-sale are frozen on OrderItem.
// ─────────────────────────────────────────────
model Product {
  id           String      @id @default(uuid())
  sku          String      @unique
  name         String
  category     String      // e.g., "SNEAKERS", "HEELS", "BAGS"
  color        String?     // Optional color variant
  size         String?     // Optional size variant (nullable — bags have no size)
  costPrice    Float
  sellingPrice Float
  stock        Int         @default(0)
  isArchived   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  orderItems   OrderItem[]
}

// ─────────────────────────────────────────────
// ORDER (Sales & Returns)
// A completed transaction. type = "SALE" | "RETURN".
// Returns are full reversals: same model, negative quantities on OrderItem.
// See ADR: docs/adr/0001-returns-as-inverted-orders.md
// ─────────────────────────────────────────────
model Order {
  id            String      @id @default(uuid())
  receiptNumber String      @unique
  invoiceNumber String?     @unique
  subTotal      Float
  // discountValue: fixed monetary amount, never a percentage.
  // The human-readable reason is stored in offerName.
  discountValue Float       @default(0)
  offerName     String?
  total         Float
  // "SALE" (default) or "RETURN". Queries for sales-only
  // must filter WHERE type = 'SALE'. See CONTEXT.md.
  type          String      @default("SALE")
  createdAt     DateTime    @default(now())

  items         OrderItem[]
}

// ─────────────────────────────────────────────
// ORDER ITEM (Line Items)
// One product line within an Order.
// priceAtSale and costAtSale are frozen snapshots — they
// must never be recalculated from the current Product fields.
// Negative quantity = returned units (see ADR 0001).
// productId is nullable with SetNull so deleting a Product
// does not destroy historical order data.
// ─────────────────────────────────────────────
model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String?
  quantity    Int
  costAtSale  Float
  priceAtSale Float
  returnedQuantity Int  @default(0)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// ─────────────────────────────────────────────
// EXPENSE (Daily Operational Costs)
// Tracks non-inventory costs (rent, utilities, wages)
// for daily profitability reports.
// ─────────────────────────────────────────────
model Expense {
  id          String   @id @default(uuid())
  category    String
  description String
  amount      Float
  createdAt   DateTime @default(now())
}
