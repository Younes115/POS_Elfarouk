generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Example initial model for the POS system
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  sku         String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
