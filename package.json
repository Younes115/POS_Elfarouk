{
  "name": "pos-elfarouk",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.config.web.ts",
    "build": "npx prisma generate && tsc -b && vite build",
    "electron:build": "npm run build && electron-builder",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "seed": "tsx src/main/prisma/seed.ts",
    "postinstall": "npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "react-to-print": "^3.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@prisma/config": "^7.8.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.10"
  },
  "oxlint": {
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": [
      "react",
      "typescript",
      "oxc"
    ],
    "options": {
      "typeAware": true
    },
    "rules": {}
  },
  "prisma": {
    "schema": "src/main/prisma/schema.prisma"
  },
  "build": {
    "appId": "com.elfarouk.pos",
    "productName": "POS Elfarouk",
    "asar": true,
    "asarUnpack": [
      "node_modules/.prisma/client/*.node",
      "node_modules/@prisma/client/**/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/@prisma/client/**/*",
      "node_modules/.prisma/client/index.js",
      "node_modules/.prisma/client/index.d.ts",
      "node_modules/.prisma/client/package.json",
      "node_modules/.prisma/client/default.js",
      "node_modules/.prisma/client/default.d.ts",
      "node_modules/.prisma/client/client.js",
      "node_modules/.prisma/client/client.d.ts",
      "node_modules/.prisma/client/schema.prisma",
      "node_modules/.prisma/client/query_engine-windows.dll.node",
      "node_modules/.prisma/client/query_compiler_fast_bg.wasm",
      "!**/*.tmp*"
    ],
    "extraResources": [
      {
        "from": "src/main/prisma/schema.prisma",
        "to": "prisma/schema.prisma"
      },
      {
        "from": "node_modules/.prisma/client/",
        "to": "prisma/",
        "filter": ["*.node"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
